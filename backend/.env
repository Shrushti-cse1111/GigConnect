# GigConnect Backend Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL with PostGIS or SQLite for zero-config local run)
DATABASE_URL="file:./dev.db"

# Redis Cache (Optional fallback in-memory)
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_SECRET=gigconnect_jwt_super_secret_key_2026_cooperative_platform
JWT_REFRESH_SECRET=gigconnect_jwt_refresh_super_secret_key_2026_pan_india
JWT_EXPIRATION=86400s
JWT_REFRESH_EXPIRATION=604800s

# Cooperative Pricing Engine Defaults
PLATFORM_CONTRIBUTION_PCT=10
WELFARE_CONTRIBUTION_PCT=4
EQUITY_CONTRIBUTION_PCT=6
MAX_SURGE_MULTIPLIER=1.5
BOOKING_LOCK_DURATION_MINUTES=5
DEFAULT_WORKER_RADIUS_KM=15

# Demo Mode Flag (enables seed reset and simulated endpoints)
DEMO_MODE=true
